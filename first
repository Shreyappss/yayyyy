#include <stdio.h>
#include <stdlib.h>

struct Node
{
    int data;
    struct Node *next;
};

struct Node *top = NULL;

// Push: Insert a new node at the head
void push()
{
    int value;
    struct Node *newNode;

    newNode = (struct Node *)malloc(sizeof(struct Node));

    // Unlike an array stack, there is no fixed size limit.
    // Therefore, overflow does not occur unless the system runs out of memory.
    if (newNode == NULL)
    {
        printf("Stack Overflow! Memory allocation failed.\n");
        return;
    }

    printf("Enter element to push: ");
    scanf("%d", &value);

    newNode->data = value;
    newNode->next = top;
    top = newNode;

    printf("%d pushed into the stack.\n", value);
}

// Pop: Delete the node at the head
void pop()
{
    struct Node *temp;

    if (top == NULL)
    {
        printf("Stack Underflow! Stack is empty.\n");
    }
    else
    {
        temp = top;
        printf("%d popped from the stack.\n", top->data);
        top = top->next;
        free(temp);
    }
}

// Peek: Display the top element
void peek()
{
    if (top == NULL)
    {
        printf("Stack Underflow! Stack is empty.\n");
    }
    else
    {
        printf("Top element is: %d\n", top->data);
    }
}

int main()
{
    int choice;

    do
    {
        printf("\n--- STACK MENU ---\n");
        printf("1. Push\n");
        printf("2. Pop\n");
        printf("3. Peek\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                push();
                break;

            case 2:
                pop();
                break;

            case 3:
                peek();
                break;

            case 4:
                printf("Exiting program...\n");
                break;

            default:
                printf("Invalid choice! Please try again.\n");
        }

    } while (choice != 4);

    return 0;
}
